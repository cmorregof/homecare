# Inlined into the browser bundle at build time. Never put a secret behind a
# NEXT_PUBLIC_ prefix, and remember these are baked in at `next build`: changing
# one in Vercel requires a redeploy, without the build cache, to take effect.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/project918_homecare_bot
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side only. Read by app/api/admin/users, which is the one place a user
# — including an administrator — can be created. The service role bypasses every
# RLS policy, so this key must never gain a NEXT_PUBLIC_ prefix. Same value as
# SUPABASE_SERVICE_KEY in the backend's .env.
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIs...

# Server-side only. Sends new users their temporary password. Without them the
# account is still created and the password is shown once to the administrator
# who created it, because Supabase stores only a bcrypt hash and it cannot be
# looked up afterwards.
RESEND_API_KEY=re_...
FROM_EMAIL=alertas@homecareccv.co
